# Приватные данные: база, cookies, профиль браузера, снимки, дампы
private_data/

# Журналы движка (содержат URL/личные данные) и старые логи
bin/log/
log/

# Локальные настройки редактора
bin/qodedesigner.ini

# Вспомогательный скрипт локальной публикации на NAS
gitpush.bat

# Распространительные компоненты Microsoft/ODBC (не входят в публикацию)
Redist/

# Временные и системные артефакты
*.tmp
*.bak
*.old
Thumbs.db
.DS_Store

# Артефакты запусков и тестов в корне проекта
out.txt
test_out.txt
*.log
